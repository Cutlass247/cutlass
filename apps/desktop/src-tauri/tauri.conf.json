{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cutlass",
  "version": "0.1.1",
  "identifier": "app.cutlass.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cutlass",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://cutlass-production.up.railway.app https://github.com https://objects.githubusercontent.com; object-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "fileAssociations": [
      {
        "ext": [
          "cutlass"
        ],
        "name": "Cutlass Project",
        "description": "Cutlass video project",
        "mimeType": "application/x-cutlass"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../vendor/ffmpeg/bin/avcodec-61.dll": "./",
      "../../../vendor/ffmpeg/bin/avdevice-61.dll": "./",
      "../../../vendor/ffmpeg/bin/avfilter-10.dll": "./",
      "../../../vendor/ffmpeg/bin/avformat-61.dll": "./",
      "../../../vendor/ffmpeg/bin/avutil-59.dll": "./",
      "../../../vendor/ffmpeg/bin/swresample-5.dll": "./",
      "../../../vendor/ffmpeg/bin/swscale-8.dll": "./",
      "../../../vendor/whisper/ggml-base.en.bin": "./",
      "../../../vendor/mdx/UVR-MDX-NET-Voc_FT.onnx": "./",
      "../../../vendor/vcredist/vcruntime140.dll": "./",
      "../../../vendor/vcredist/vcruntime140_1.dll": "./",
      "../../../vendor/vcredist/msvcp140.dll": "./",
      "../../../vendor/vcredist/msvcp140_1.dll": "./",
      "../../../vendor/vcredist/msvcp140_2.dll": "./",
      "../../../vendor/vcredist/msvcp140_atomic_wait.dll": "./",
      "../../../vendor/vcredist/msvcp140_codecvt_ids.dll": "./",
      "../../../vendor/vcredist/concrt140.dll": "./",
      "../../../vendor/ffmpeg/bin/ffmpeg.exe": "./",
      "../../../vendor/ffmpeg/LICENSE.txt": "./licenses/FFMPEG-LICENSE.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Cutlass247/cutlass/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2QTdBQzg5MTBFMDgxNzUKUldSMWdlQVFpYXluUnR5WXU4bHFVQjk2bytiTlpRZGFDQnBWRFRqcEVMNWNTanRLbm9tNEVNS0YK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
